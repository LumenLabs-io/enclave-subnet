# Wallet. The hotkey must be registered on netuid 92 and admitted by the subnet owner.
ENCLAVE_WALLET_NAME=validator
ENCLAVE_WALLET_HOTKEY=default

# Provider credential. Required unless ENCLAVE_DRY_RUN is set.
ENCLAVE_PROVIDER_BASE_URL=
ENCLAVE_PROVIDER_API_KEY=

# Local state
ENCLAVE_LEDGER_ROOT=./state/ledger
ENCLAVE_SOCKET_ROOT=./state/sockets

# Hardware. Operator settings; none of these change what a score means.
ENCLAVE_CONTAINER_CPUS=2.0
ENCLAVE_CONTAINER_MEMORY_GIB=4
ENCLAVE_CONTAINER_WALL_CLOCK_SECONDS=900

ENCLAVE_DRY_RUN=false
ENCLAVE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Not settings.
#
# The control plane url and the owner public key are compiled in. A validator
# that could point itself at another control plane, or trust another signing
# key, could grant itself whatever prices and scoring parameters it liked and
# still call itself an Enclave validator. Setting either of these to anything
# other than the compiled value is refused at startup.
#
#   ENCLAVE_CONTROL_PLANE_URL   https://api.nclv.io
#   ENCLAVE_OWNER_PUBLIC_KEY    5F4pTG5AzJwVoRUw97qPCVYAXUPthKTRoKLtKCsVbpccVKkg
#
# The price snapshot, the default model, the families, and the instance count
# arrive in the owner signed directive. There is no snapshot file to author.
# The four below are read only by `open-round --local-snapshot`, which is for
# debugging and warns that the round will not agree with the field.
#
#   ENCLAVE_PRICE_SNAPSHOT=./state/prices.json
#   ENCLAVE_DEFAULT_MODEL=
#   ENCLAVE_FAMILIES=["archive"]
#   ENCLAVE_INSTANCES_PER_FAMILY=24
# ---------------------------------------------------------------------------
